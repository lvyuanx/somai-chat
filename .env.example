SOMAI_ENVIRONMENT=development
SOMAI_LOG_LEVEL=INFO
SOMAI_HOST=0.0.0.0
SOMAI_PORT=8000
SOMAI_OPENAI_BASE_URL=https://api.openai.com/v1
SOMAI_OPENAI_API_KEY=replace-me
SOMAI_OPENAI_MODEL=replace-with-compatible-model
SOMAI_DATABASE_URL=mysql+asyncmy://somai:replace-with-password@127.0.0.1:3306/somai
SOMAI_ADMIN_USERNAME=admin
SOMAI_ADMIN_PASSWORD=123456
SOMAI_ADMIN_SESSION_SECRET=replace-with-random-session-secret
SOMAI_CLIENT_KEY_PEPPER=replace-with-random-client-key-pepper
SOMAI_CLIENT_KEY_ENCRYPTION_SECRET=replace-with-random-client-key-encryption-secret
SOMAI_MODEL_TEMPERATURE=0.4
SOMAI_MODEL_MAX_TOKENS=800
SOMAI_MODEL_TIMEOUT_SECONDS=30
SOMAI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SOMAI_VISION_API_KEY=replace-with-dashscope-api-key
SOMAI_VISION_MODEL=qwen3-vl-plus
SOMAI_VISION_TIMEOUT_SECONDS=30
SOMAI_MEDIA_ROOT=./media
SOMAI_MAX_IMAGE_URLS=4
SOMAI_MAX_IMAGE_DOWNLOAD_BYTES=8388608
SOMAI_QWEATHER_API_HOST=https://replace-with-your-api-host.qweatherapi.com
SOMAI_QWEATHER_API_KEY=replace-with-your-api-key
SOMAI_WEATHER_TIMEOUT_SECONDS=5
SOMAI_TAVILY_API_HOST=https://api.tavily.com
SOMAI_TAVILY_API_KEY=replace-with-tavily-api-key
SOMAI_TAVILY_TIMEOUT_SECONDS=10
SOMAI_TAVILY_MAX_RESULTS=5
SOMAI_MAX_MESSAGE_LENGTH=8000
SOMAI_MAX_WEBSOCKET_MESSAGE_BYTES=32768
SOMAI_WEBSOCKET_TRANSPORT_MAX_BYTES=1048576
SOMAI_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
